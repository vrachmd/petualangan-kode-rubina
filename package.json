{
  "name": "petualangan-kode-rubina",
  "version": "0.1.0",
  "description": "Printable worksheet coding Bahasa Indonesia untuk anak 2 tahun",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "download-assets": "tsx src/scripts/download-assets.ts && tsx src/scripts/download-assets-sfx.ts",
    "generate:audio": "python scripts/generate-audio.py",
    "generate:sw": "tsx src/scripts/generate-sw.ts",
    "generate:pdf": "tsx src/scripts/generate-pdf.ts",
    "generate:png": "tsx src/scripts/generate-png.ts",
    "generate:svg": "tsx src/scripts/generate-svg.ts",
    "generate:all": "npm run build && npm run generate:sw && npm run generate:pdf && npm run generate:png && npm run generate:svg",
    "validate": "tsx src/scripts/validate-output.ts",
    "package": "npm run generate:all && npm run validate",
    "clean": "rimraf dist output .astro",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "download-assets-sfx": "tsx src/scripts/download-assets-sfx.ts"
  },
  "dependencies": {
    "@astrojs/preact": "^6.0.5",
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@fontsource/nunito": "^5.2.5",
    "@fontsource/quicksand": "^5.2.5",
    "astro": "^7.3.2",
    "pdf-lib": "^1.17.1",
    "preact": "^10.29.8",
    "sharp": "^0.35.4",
    "svgo": "^3.3.2",
    "tailwindcss": "^3.4.17",
    "workbox-build": "^7.4.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.10.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^10.10.0",
    "eslint-plugin-astro": "^3.1.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "playwright": "^1.49.1",
    "postcss": "^8.4.49",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^1.0.0",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.70.0"
  }
}
