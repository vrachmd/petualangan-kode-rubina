---
import WorksheetLayout from "../../../layouts/WorksheetLayout.astro";
import GameLayout from "../../../components/interactive/GameLayout";
import AudioButton from "../../../components/interactive/AudioButton";
import ProgressBar from "../../../components/interactive/ProgressBar";
import FreePlayCanvas from "../../../components/interactive/FreePlayCanvas";
---

<WorksheetLayout title="Game Robotku">
  <GameLayout judul="Robotku" kembali="/game/" client:load>
    <div class="flex items-center justify-between">
      <AudioButton
        audioKey="game/bebas-robot"
        text="Gambar robotmu! Coret dengan jari!"
        client:load
      />
      <ProgressBar ids={["19-bebas-gambar-robot"]} client:load />
    </div>
    <div class="mt-4">
      <FreePlayCanvas idHalaman="19-bebas-gambar-robot" client:load />
    </div>
  </GameLayout>
</WorksheetLayout>
