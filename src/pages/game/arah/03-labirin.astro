---
import WorksheetLayout from "../../../layouts/WorksheetLayout.astro";
import GameLayout from "../../../components/interactive/GameLayout";
import AudioButton from "../../../components/interactive/AudioButton";
import ProgressBar from "../../../components/interactive/ProgressBar";
import ArrowGame from "../../../components/interactive/ArrowGame";
import ninaSvg from "../../../assets/characters/nina-rubah.svg?raw";
import wortelSvg from "../../../assets/illustrations/wortel.svg?raw";
---

<WorksheetLayout title="Game Jalan ke Wortel">
  <GameLayout judul="Jalan ke Wortel" kembali="/game/" client:load>
    <div class="flex items-center justify-between">
      <AudioButton
        audioKey="game/arah-wortel"
        text="Antar Nina ke wortel! Ikuti panahnya!"
        client:load
      />
      <ProgressBar ids={["12-arah-labirin"]} client:load />
    </div>
    <div class="mt-4">
      <ArrowGame
        idHalaman="12-arah-labirin"
        jalur={["kanan", "kanan", "bawah", "kiri", "bawah"]}
        kolom={3}
        maskotSvg={ninaSvg}
        rumahSvg={wortelSvg}
        tujuanLabel="Wortel"
        client:load
      />
    </div>
  </GameLayout>
</WorksheetLayout>
