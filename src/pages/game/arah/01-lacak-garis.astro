---
import WorksheetLayout from "../../../layouts/WorksheetLayout.astro";
import GameLayout from "../../../components/interactive/GameLayout";
import AudioButton from "../../../components/interactive/AudioButton";
import ProgressBar from "../../../components/interactive/ProgressBar";
import ArrowGame from "../../../components/interactive/ArrowGame";
import ninaSvg from "../../../assets/characters/nina-rubah.svg?raw";
import benderaSvg from "../../../assets/illustrations/bendera-finish.svg?raw";
---

<WorksheetLayout title="Game Jalan Lurus">
  <GameLayout judul="Jalan Lurus" kembali="/game/" client:load>
    <div class="flex items-center justify-between">
      <AudioButton audioKey="game/arah-lurus" text="Ketuk kotak berikutnya! Maju terus!" client:load />
      <ProgressBar ids={["10-arah-lacak-garis"]} client:load />
    </div>
    <div class="mt-4">
      <ArrowGame
        idHalaman="10-arah-lacak-garis"
        jalur={["kanan", "kanan", "kanan"]}
        kolom={3}
        maskotSvg={ninaSvg}
        rumahSvg={benderaSvg}
        tujuanLabel="Bendera"
        audioKey="game/arah-lurus"
        audioText="Maju, maju, sampai bendera!"
        client:load
      />
    </div>
  </GameLayout>
</WorksheetLayout>
