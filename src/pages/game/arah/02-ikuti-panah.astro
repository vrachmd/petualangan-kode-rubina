---
import WorksheetLayout from "../../../layouts/WorksheetLayout.astro";
import GameLayout from "../../../components/interactive/GameLayout";
import AudioButton from "../../../components/interactive/AudioButton";
import ProgressBar from "../../../components/interactive/ProgressBar";
import ArrowGame from "../../../components/interactive/ArrowGame";
import ninaSvg from "../../../assets/characters/nina-rubah.svg?raw";
import rumahSvg from "../../../assets/illustrations/rumah.svg?raw";
---

<WorksheetLayout title="Game Belok-Belok">
  <GameLayout judul="Belok-Belok" kembali="/game/" client:load>
    <div class="flex items-center justify-between">
      <AudioButton audioKey="game/arah-belok" text="Ikuti panahnya! Belok kanan, turun!" client:load />
      <ProgressBar ids={["11-arah-ikuti-panah"]} client:load />
    </div>
    <div class="mt-4">
      <ArrowGame
        idHalaman="11-arah-ikuti-panah"
        jalur={["kanan", "bawah", "kanan", "bawah"]}
        kolom={3}
        maskotSvg={ninaSvg}
        rumahSvg={rumahSvg}
        audioKey="game/arah-belok"
        audioText="Kanan, turun, kanan, turun, sampai!"
        client:load
      />
    </div>
  </GameLayout>
</WorksheetLayout>
