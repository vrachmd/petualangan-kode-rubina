---
import WorksheetLayout from "../../../layouts/WorksheetLayout.astro";
import GameLayout from "../../../components/interactive/GameLayout";
import AudioButton from "../../../components/interactive/AudioButton";
import ProgressBar from "../../../components/interactive/ProgressBar";
import IfThenGame from "../../../components/interactive/IfThenGame";
import merahSvg from "../../../assets/illustrations/lingkaran-merah.svg?raw";
import biruSvg from "../../../assets/illustrations/lingkaran-biru.svg?raw";
import lampuSvg from "../../../assets/illustrations/lampu.svg?raw";
import bulanSvg from "../../../assets/illustrations/bulan.svg?raw";
---

<WorksheetLayout title="Game Tombol Ajaib">
  <GameLayout judul="Tombol Ajaib" kembali="/game/" autoAudioKey="game/sebab-tombol" autoAudioText="Ketuk tombolnya! Apa yang terjadi?" client:load>
    <div class="flex items-center justify-between">
      <AudioButton audioKey="game/sebab-tombol" text="Ketuk tombolnya! Apa yang terjadi?" client:load />
      <ProgressBar ids={["14-sebab-tombol-lampu"]} client:load />
    </div>
    <div class="mt-4">
      <IfThenGame
        idHalaman="14-sebab-tombol-lampu"
        pasangan={[
          { aksiSvg: merahSvg, aksiLabel: "Tekan merah", hasilSvg: lampuSvg, hasilLabel: "Lampu nyala!", suara: "Tekan merah, lampu nyala!" },
          { aksiSvg: biruSvg, aksiLabel: "Tekan biru", hasilSvg: bulanSvg, hasilLabel: "Gelap, bobo!", suara: "Tekan biru, gelap, bobo!" },
        ]}
        audioKey="game/sebab-tombol"
        audioText="Ketuk tombol merah dan biru!"
        client:load
      />
    </div>
  </GameLayout>
</WorksheetLayout>
