---
import WorksheetLayout from "../../../layouts/WorksheetLayout.astro";
import GameLayout from "../../../components/interactive/GameLayout";
import AudioButton from "../../../components/interactive/AudioButton";
import ProgressBar from "../../../components/interactive/ProgressBar";
import SequenceGame from "../../../components/interactive/SequenceGame";
import bajuSvg from "../../../assets/illustrations/baju.svg?raw";
import sikatSvg from "../../../assets/illustrations/sikat-gigi.svg?raw";
import tidurSvg from "../../../assets/illustrations/tempat-tidur.svg?raw";
---

<WorksheetLayout title="Game Bobo Malam">
  <GameLayout judul="Bobo Malam" kembali="/game/" client:load>
    <div class="flex items-center justify-between">
      <AudioButton
        audioKey="game/seq-tidur"
        text="Ketuk gambar nomor satu, dua, tiga!"
        client:load
      />
      <ProgressBar ids={["08-sequencing-tidur"]} client:load />
    </div>
    <div class="mt-4">
      <SequenceGame
        idHalaman="08-sequencing-tidur"
        langkah={[
          { svg: bajuSvg, label: "Ganti baju" },
          { svg: sikatSvg, label: "Sikat gigi" },
          { svg: tidurSvg, label: "Bobo!" },
        ]}
        audioKey="game/seq-tidur"
        audioText="Pertama ganti baju, lalu sikat gigi, terakhir bobo!"
        client:load
      />
    </div>
  </GameLayout>
</WorksheetLayout>
