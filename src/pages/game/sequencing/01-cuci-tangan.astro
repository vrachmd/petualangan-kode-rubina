---
import WorksheetLayout from "../../../layouts/WorksheetLayout.astro";
import GameLayout from "../../../components/interactive/GameLayout";
import AudioButton from "../../../components/interactive/AudioButton";
import ProgressBar from "../../../components/interactive/ProgressBar";
import SequenceGame from "../../../components/interactive/SequenceGame";
import keranSvg from "../../../assets/illustrations/keran.svg?raw";
import sabunSvg from "../../../assets/illustrations/sabun.svg?raw";
import tetesSvg from "../../../assets/illustrations/tetes-air.svg?raw";
---

<WorksheetLayout title="Game Cuci Tangan">
  <GameLayout judul="Cuci Tangan Dulu" kembali="/game/" client:load>
    <div class="flex items-center justify-between">
      <AudioButton
        audioKey="game/seq-cuci"
        text="Ketuk gambar nomor satu, dua, tiga!"
        client:load
      />
      <ProgressBar ids={["06-sequencing-cuci-tangan"]} client:load />
    </div>
    <div class="mt-4">
      <SequenceGame
        idHalaman="06-sequencing-cuci-tangan"
        langkah={[
          { svg: keranSvg, label: "Buka keran" },
          { svg: sabunSvg, label: "Sabun" },
          { svg: tetesSvg, label: "Bilas" },
        ]}
        audioKey="game/seq-cuci"
        audioText="Pertama buka keran, lalu sabun, terakhir bilas!"
        client:load
      />
    </div>
  </GameLayout>
</WorksheetLayout>
