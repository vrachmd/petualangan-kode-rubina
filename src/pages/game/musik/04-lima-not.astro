---
import WorksheetLayout from "../../../layouts/WorksheetLayout.astro";
import GameLayout from "../../../components/interactive/GameLayout";
import ProgressBar from "../../../components/interactive/ProgressBar";
import AudioPatternGame from "../../../components/interactive/AudioPatternGame";
---

<WorksheetLayout title="Game Pola Lima Nada">
  <GameLayout judul="Pola Lima Nada 🎵" kembali="/game/" client:load>
    <div class="flex items-center justify-between">
      <p class="font-sans text-base text-muted">Dengarkan, lalu ulangi!</p>
      <ProgressBar ids={["musik-lima-not"]} client:load />
    </div>
    <div class="mt-4">
      <AudioPatternGame idHalaman="musik-lima-not" panjang={5} client:load />
    </div>
  </GameLayout>
</WorksheetLayout>
