---
import WorksheetLayout from "../../../layouts/WorksheetLayout.astro";
import GameLayout from "../../../components/interactive/GameLayout";
import AudioButton from "../../../components/interactive/AudioButton";
import ProgressBar from "../../../components/interactive/ProgressBar";
import ShapeBuilderGame from "../../../components/interactive/ShapeBuilderGame";
---

<WorksheetLayout title="Game Bentuk Campuran">
  <GameLayout judul="Buat Gambar Campuran" kembali="/game/" client:load>
    <div class="flex items-center justify-between">
      <AudioButton
        audioKey="game/bentuk-campuran"
        text="Pilih bentuk yang tepat, lalu ketuk kotak yang benar untuk membuat gambar!"
        client:load
      />
      <ProgressBar ids={["bentuk-campuran"]} client:load />
    </div>
    <div class="mt-4">
      <ShapeBuilderGame
        idHalaman="bentuk-campuran"
        gridSize={3}
        targets={[
          {
            row: 0,
            col: 0,
            shape: { type: "lingkaran", color: "#E85D75", label: "Lingkaran merah muda" },
          },
          {
            row: 0,
            col: 2,
            shape: { type: "lingkaran", color: "#E85D75", label: "Lingkaran merah muda" },
          },
          {
            row: 1,
            col: 1,
            shape: { type: "segitiga", color: "#FACC15", label: "Segitiga kuning" },
          },
          { row: 2, col: 0, shape: { type: "kotak", color: "#38BDF8", label: "Kotak biru" } },
          { row: 2, col: 2, shape: { type: "kotak", color: "#38BDF8", label: "Kotak biru" } },
        ]}
        palette={[
          { type: "lingkaran", color: "#E85D75", label: "Lingkaran merah muda" },
          { type: "segitiga", color: "#FACC15", label: "Segitiga kuning" },
          { type: "kotak", color: "#38BDF8", label: "Kotak biru" },
        ]}
        client:load
      />
    </div>
  </GameLayout>
</WorksheetLayout>
