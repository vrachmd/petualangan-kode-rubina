---
import WorksheetLayout from "../../../layouts/WorksheetLayout.astro";
import GameLayout from "../../../components/interactive/GameLayout";
import AudioButton from "../../../components/interactive/AudioButton";
import ProgressBar from "../../../components/interactive/ProgressBar";
import ShapeBuilderGame from "../../../components/interactive/ShapeBuilderGame";
---

<WorksheetLayout title="Game Bentuk Segitiga">
  <GameLayout judul="Buat Pohon Segitiga" kembali="/game/" client:load>
    <div class="flex items-center justify-between">
      <AudioButton
        audioKey="game/bentuk-segitiga"
        text="Pilih bentuk segitiga, lalu ketuk kotak yang benar untuk membuat pohon!"
        client:load
      />
      <ProgressBar ids={["bentuk-segitiga"]} client:load />
    </div>
    <div class="mt-4">
      <ShapeBuilderGame
        idHalaman="bentuk-segitiga"
        gridSize={3}
        targets={[
          {
            row: 0,
            col: 1,
            shape: { type: "segitiga", color: "#4ADE80", label: "Segitiga hijau" },
          },
          {
            row: 1,
            col: 0,
            shape: { type: "segitiga", color: "#4ADE80", label: "Segitiga hijau" },
          },
          {
            row: 1,
            col: 1,
            shape: { type: "segitiga", color: "#4ADE80", label: "Segitiga hijau" },
          },
          {
            row: 1,
            col: 2,
            shape: { type: "segitiga", color: "#4ADE80", label: "Segitiga hijau" },
          },
          {
            row: 2,
            col: 1,
            shape: { type: "segitiga", color: "#F97316", label: "Segitiga oranye" },
          },
        ]}
        palette={[
          { type: "segitiga", color: "#4ADE80", label: "Segitiga hijau" },
          { type: "segitiga", color: "#F97316", label: "Segitiga oranye" },
        ]}
        client:load
      />
    </div>
  </GameLayout>
</WorksheetLayout>
