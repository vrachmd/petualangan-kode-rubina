---
import WorksheetLayout from "../../../layouts/WorksheetLayout.astro";
import GameLayout from "../../../components/interactive/GameLayout";
import ProgressBar from "../../../components/interactive/ProgressBar";
import AnimalSoundGame from "../../../components/interactive/AnimalSoundGame";

const KUCING_LIST = [
  { key: "kucing", emoji: "🐱", label: "Kucing" },
  { key: "anjing", emoji: "🐶", label: "Anjing" },
  { key: "burung", emoji: "🐦", label: "Burung" },
  { key: "katak", emoji: "🐸", label: "Katak" },
];
---

<WorksheetLayout title="Game Suara Kucing">
  <GameLayout judul="Suara Kucing 🐱" kembali="/game/" client:load>
    <div class="flex items-center justify-between">
      <p class="font-sans text-base text-muted">Dengarkan suaranya!</p>
      <ProgressBar ids={["hewan-kucing"]} client:load />
    </div>
    <div class="mt-4">
      <AnimalSoundGame
        idHalaman="hewan-kucing"
        hewanList={KUCING_LIST}
        target="kucing"
        pesanMenang="Benar! Itu suara kucing! Meow~ 🐱"
        client:load
      />
    </div>
  </GameLayout>
</WorksheetLayout>
