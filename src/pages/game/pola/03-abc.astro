---
import WorksheetLayout from "../../../layouts/WorksheetLayout.astro";
import GameLayout from "../../../components/interactive/GameLayout";
import AudioButton from "../../../components/interactive/AudioButton";
import ProgressBar from "../../../components/interactive/ProgressBar";
import PatternGame from "../../../components/interactive/PatternGame";
import { palet } from "../../../components/interactive/palet";
---

<WorksheetLayout title="Game Pola A-B-C">
  <GameLayout judul="Pola A-B-C" kembali="/game/" autoAudioKey="game/pola-abc" autoAudioText="A, B, C! Ketuk warnanya bergantian!" client:load>
    <div class="flex items-center justify-between">
      <AudioButton audioKey="game/pola-abc" text="A, B, C! Ketuk warnanya bergantian!" client:load />
      <ProgressBar ids={["04-pola-abc"]} client:load />
    </div>
    <div class="mt-4">
      <PatternGame
        idHalaman="04-pola-abc"
        warna={palet("pink", "sunny", "sky")}
        pola={["pink", "sunny", "sky", "pink", "sunny", null]}
        jawaban={["pink", "sunny", "sky", "pink", "sunny", "sky"]}
        audioKey="game/pola-abc"
        audioText="A, B, C bergantian!"
        client:load
      />
    </div>
  </GameLayout>
</WorksheetLayout>
