---
import WorksheetLayout from "../../../layouts/WorksheetLayout.astro";
import GameLayout from "../../../components/interactive/GameLayout";
import AudioButton from "../../../components/interactive/AudioButton";
import ProgressBar from "../../../components/interactive/ProgressBar";
import PatternGame from "../../../components/interactive/PatternGame";
import { palet } from "../../../components/interactive/palet";
---

<WorksheetLayout title="Game Tantangan Pola">
  <GameLayout judul="Tantangan Pola" kembali="/game/" client:load>
    <div class="flex items-center justify-between">
      <AudioButton
        audioKey="game/pola-campuran"
        text="Lengkapi polanya! Kamu pasti bisa!"
        client:load
      />
      <ProgressBar ids={["05-pola-campuran"]} client:load />
    </div>
    <div class="mt-4">
      <PatternGame
        idHalaman="05-pola-campuran"
        warna={palet("lavender", "peach", "mint")}
        pola={["lavender", "peach", "mint", "lavender", null, null]}
        jawaban={["lavender", "peach", "mint", "lavender", "peach", "mint"]}
        audioKey="game/pola-campuran"
        audioText="Lengkapi tiga warna bergantian!"
        client:load
      />
    </div>
  </GameLayout>
</WorksheetLayout>
