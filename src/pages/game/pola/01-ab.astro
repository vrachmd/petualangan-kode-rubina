---
import WorksheetLayout from "../../../layouts/WorksheetLayout.astro";
import GameLayout from "../../../components/interactive/GameLayout";
import AudioButton from "../../../components/interactive/AudioButton";
import ProgressBar from "../../../components/interactive/ProgressBar";
import PatternGame from "../../../components/interactive/PatternGame";
import { palet } from "../../../components/interactive/palet";
---

<WorksheetLayout title="Game Pola Merah-Kuning">
  <GameLayout judul="Pola Merah-Kuning" kembali="/game/" autoAudioKey="game/pola-ab" autoAudioText="Ketuk warna merah muda, lalu ketuk lingkaran kosong!" client:load>
    <div class="flex items-center justify-between">
      <AudioButton audioKey="game/pola-ab" text="Ketuk warna merah muda, lalu ketuk lingkaran kosong!" client:load />
      <ProgressBar ids={["02-pola-ab"]} client:load />
    </div>
    <div class="mt-4">
      <PatternGame
        idHalaman="02-pola-ab"
        warna={palet("pink", "sunny")}
        pola={["pink", "sunny", "pink", "sunny", null, null]}
        jawaban={["pink", "sunny", "pink", "sunny", "pink", "sunny"]}
        audioKey="game/pola-ab"
        audioText="Pilih warna dulu, lalu ketuk lingkaran kosong!"
        client:load
      />
    </div>
  </GameLayout>
</WorksheetLayout>
