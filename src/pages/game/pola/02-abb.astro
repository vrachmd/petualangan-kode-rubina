---
import WorksheetLayout from "../../../layouts/WorksheetLayout.astro";
import GameLayout from "../../../components/interactive/GameLayout";
import AudioButton from "../../../components/interactive/AudioButton";
import ProgressBar from "../../../components/interactive/ProgressBar";
import PatternGame from "../../../components/interactive/PatternGame";
import { palet } from "../../../components/interactive/palet";
---

<WorksheetLayout title="Game Pola Dua-Satu">
  <GameLayout judul="Pola Dua-Satu" kembali="/game/" client:load>
    <div class="flex items-center justify-between">
      <AudioButton audioKey="game/pola-abb" text="Dua hijau, satu biru! Ketuk warnanya!" client:load />
      <ProgressBar ids={["03-pola-abb"]} client:load />
    </div>
    <div class="mt-4">
      <PatternGame
        idHalaman="03-pola-abb"
        warna={palet("mint", "sky")}
        pola={["mint", "mint", "sky", "mint", "mint", null]}
        jawaban={["mint", "mint", "sky", "mint", "mint", "sky"]}
        audioKey="game/pola-abb"
        audioText="Dua hijau, satu biru!"
        client:load
      />
    </div>
  </GameLayout>
</WorksheetLayout>
