---
import WorksheetLayout from "../../../layouts/WorksheetLayout.astro";
import GameLayout from "../../../components/interactive/GameLayout";
import AudioButton from "../../../components/interactive/AudioButton";
import ProgressBar from "../../../components/interactive/ProgressBar";
import ColorMixingGame from "../../../components/interactive/ColorMixingGame";
---

<WorksheetLayout title="Game Warna Campuran">
  <GameLayout judul="Merah + Biru + Kuning = Cokelat" kembali="/game/" client:load>
    <div class="flex items-center justify-between">
      <AudioButton
        audioKey="game/warna-campuran"
        text="Ketuk ketiga warna: merah, biru, dan kuning untuk membuat cokelat!"
        client:load
      />
      <ProgressBar ids={["warna-campuran"]} client:load />
    </div>
    <div class="mt-4">
      <ColorMixingGame
        idHalaman="warna-campuran"
        warna={[
          { key: "merah", label: "Merah", hex: "#E85D75" },
          { key: "biru", label: "Biru", hex: "#38BDF8" },
          { key: "kuning", label: "Kuning", hex: "#FACC15" },
        ]}
        targetHex="#92400E"
        targetLabel="Cokelat"
        jawaban={["merah", "biru", "kuning"]}
        audioKey="game/warna-campuran"
        audioText="Ketuk merah, biru, dan kuning!"
        client:load
      />
    </div>
  </GameLayout>
</WorksheetLayout>
