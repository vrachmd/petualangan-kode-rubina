---
import WorksheetLayout from "../../../layouts/WorksheetLayout.astro";
import GameLayout from "../../../components/interactive/GameLayout";
import AudioButton from "../../../components/interactive/AudioButton";
import ProgressBar from "../../../components/interactive/ProgressBar";
import ColorMixingGame from "../../../components/interactive/ColorMixingGame";
---

<WorksheetLayout title="Game Warna Merah Biru">
  <GameLayout judul="Merah + Biru = Ungu" kembali="/game/" client:load>
    <div class="flex items-center justify-between">
      <AudioButton
        audioKey="game/warna-merah-biru"
        text="Ketuk warna merah, lalu ketuk warna biru untuk membuat ungu!"
        client:load
      />
      <ProgressBar ids={["warna-merah-biru"]} client:load />
    </div>
    <div class="mt-4">
      <ColorMixingGame
        idHalaman="warna-merah-biru"
        warna={[
          { key: "merah", label: "Merah", hex: "#E85D75" },
          { key: "biru", label: "Biru", hex: "#38BDF8" },
        ]}
        targetHex="#A855F7"
        targetLabel="Ungu"
        jawaban={["merah", "biru"]}
        audioKey="game/warna-merah-biru"
        audioText="Ketuk warna merah, lalu biru!"
        client:load
      />
    </div>
  </GameLayout>
</WorksheetLayout>
