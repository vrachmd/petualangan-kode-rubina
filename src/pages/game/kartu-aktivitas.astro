---
import WorksheetLayout from "../../layouts/WorksheetLayout.astro";
import GameLayout from "../../components/interactive/GameLayout";
import AudioButton from "../../components/interactive/AudioButton";
import ProgressBar from "../../components/interactive/ProgressBar";
import ActivitySpinner from "../../components/interactive/ActivitySpinner";
import lompatSvg from "../../assets/illustrations/lompat.svg?raw";
import putarSvg from "../../assets/illustrations/putar.svg?raw";
import hidungSvg from "../../assets/illustrations/hidung.svg?raw";
import kursiSvg from "../../assets/illustrations/kursi.svg?raw";
import tepukSvg from "../../assets/illustrations/tepuk.svg?raw";
import lariSvg from "../../assets/illustrations/lari.svg?raw";
---

<WorksheetLayout title="Game Kartu Gerak">
  <GameLayout judul="Kartu Gerak" kembali="/game/" autoAudioKey="game/kartu" autoAudioText="Ketuk putar, ikuti gerakannya!" client:load>
    <div class="flex items-center justify-between">
      <AudioButton audioKey="game/kartu" text="Ketuk putar, ikuti gerakannya!" client:load />
      <ProgressBar ids={["17-kartu-aktivitas"]} client:load />
    </div>
    <div class="mt-4">
      <ActivitySpinner
        idHalaman="17-kartu-aktivitas"
        aktivitas={[
          { svg: lompatSvg, perintah: "Lompat 2 kali", suara: "Lompat dua kali!" },
          { svg: putarSvg, perintah: "Putar badan", suara: "Putar badanmu!" },
          { svg: hidungSvg, perintah: "Sentuh hidung", suara: "Sentuh hidungmu!" },
          { svg: kursiSvg, perintah: "Duduk manis", suara: "Duduk manis!" },
          { svg: tepukSvg, perintah: "Tepuk tangan", suara: "Tepuk tangan!" },
          { svg: lariSvg, perintah: "Lari di tempat", suara: "Lari di tempat!" },
        ]}
        audioKey="game/kartu"
        audioText="Ketuk PUTAR lalu ikuti!"
        client:load
      />
    </div>
  </GameLayout>
</WorksheetLayout>
