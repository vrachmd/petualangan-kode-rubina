---
import WorksheetLayout from "../../../layouts/WorksheetLayout.astro";
import GameLayout from "../../../components/interactive/GameLayout";
import ProgressBar from "../../../components/interactive/ProgressBar";
import MemoryMatchGame from "../../../components/interactive/MemoryMatchGame";
---

<WorksheetLayout title="Game Memory Tiga Pasang">
  <GameLayout judul="Memory: Tiga Pasang 🃏" kembali="/game/" client:load>
    <div class="flex items-center justify-between">
      <p class="font-sans text-base text-muted">Cari pasangan buah!</p>
      <ProgressBar ids={["memory-tiga-pasang"]} client:load />
    </div>
    <div class="mt-4">
      <MemoryMatchGame
        idHalaman="memory-tiga-pasang"
        emojis={["🍎", "🍊", "🍋"]}
        gridCols={3}
        client:load
      />
    </div>
  </GameLayout>
</WorksheetLayout>
