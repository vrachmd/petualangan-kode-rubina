---
import WorksheetLayout from "../../../layouts/WorksheetLayout.astro";
import GameLayout from "../../../components/interactive/GameLayout";
import ProgressBar from "../../../components/interactive/ProgressBar";
import MemoryMatchGame from "../../../components/interactive/MemoryMatchGame";
---

<WorksheetLayout title="Game Memory Lima Pasang">
  <GameLayout judul="Memory: Lima Pasang 🃏" kembali="/game/" client:load>
    <div class="flex items-center justify-between">
      <p class="font-sans text-base text-muted">Cari pasangan hewan!</p>
      <ProgressBar ids={["memory-lima-pasang"]} client:load />
    </div>
    <div class="mt-4">
      <MemoryMatchGame
        idHalaman="memory-lima-pasang"
        emojis={["🐱", "🐶", "🐰", "🐻", "🦊"]}
        gridCols={5}
        client:load
      />
    </div>
  </GameLayout>
</WorksheetLayout>
