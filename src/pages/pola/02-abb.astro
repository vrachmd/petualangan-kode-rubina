---
import WorksheetLayout from "../../layouts/WorksheetLayout.astro";
import PageWrapper from "../../components/layout/PageWrapper.astro";
import Header from "../../components/layout/Header.astro";
import Footer from "../../components/layout/Footer.astro";
import ParentNote from "../../components/layout/ParentNote.astro";
import Box from "../../components/base/Box.astro";
import Text from "../../components/base/Text.astro";
import PatternRow from "../../components/worksheet/PatternRow.astro";
---

<WorksheetLayout title="Pola Dua-Satu">
  <PageWrapper>
    <Header
      judul="Pola Dua-Satu"
      karakter="Rubi si Kelinci"
      emoji="🐰"
      maskot="rubi-kelinci"
      tint="bg-rubina-pink-100"
    />

    <div class="mt-6 flex flex-col gap-6">
      <Box variant="card" class="p-6">
        <Text variant="heading">Dua sama, satu beda. Warnai yang kosong!</Text>
        <Text variant="note">Bintang biar beda walau dicetak hitam-putih.</Text>
        <div class="mt-4">
          <PatternRow
            items={[
              { bentuk: "lingkaran", kelas: "bg-rubina-mint-500" },
              { bentuk: "lingkaran", kelas: "bg-rubina-mint-500" },
              { bentuk: "bintang", kelas: "text-rubina-sky-500" },
              { bentuk: "lingkaran", kelas: "bg-rubina-mint-500" },
              { bentuk: "lingkaran", kelas: "bg-rubina-mint-500" },
            ]}
            kosong={1}
          />
        </div>
      </Box>

      <Box variant="card" class="p-6">
        <Text variant="heading">Lagi! Dua lingkaran, satu bintang.</Text>
        <div class="mt-4">
          <PatternRow
            items={[
              { bentuk: "bintang", kelas: "text-rubina-sunny-500" },
              { bentuk: "lingkaran", kelas: "bg-rubina-pink-500" },
              { bentuk: "lingkaran", kelas: "bg-rubina-pink-500" },
              { bentuk: "bintang", kelas: "text-rubina-sunny-500" },
            ]}
            kosong={2}
          />
        </div>
      </Box>
    </div>

    <ParentNote instruksi="Tunjuk pasangannya: 'dua sama, satu beda'. Minta anak menunjuk bintangnya." />
    <Footer nomor={4} />
  </PageWrapper>
</WorksheetLayout>
