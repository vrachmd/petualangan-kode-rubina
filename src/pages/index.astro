---
import WorksheetLayout from "../layouts/WorksheetLayout.astro";
import PageWrapper from "../components/layout/PageWrapper.astro";
import Footer from "../components/layout/Footer.astro";
import ParentNote from "../components/layout/ParentNote.astro";
import Text from "../components/base/Text.astro";
import Icon from "../components/base/Icon.astro";
import { NAMA_ANAK } from "../utils/nama";
---

<WorksheetLayout title="Sampul">
  <PageWrapper>
    <div class="flex flex-1 flex-col items-center gap-5 py-4 text-center">
      <div class="flex items-center gap-3">
        <Icon name="matahari" size={48} />
        <Icon name="awan" size={56} />
        <Icon name="bunga" size={48} />
      </div>

      <div>
        <Text as="h1" variant="title" class="text-rubina-pink-600">Petualangan Kode {NAMA_ANAK}</Text>
        <Text variant="heading" class="mt-2">Worksheet Coding untuk Anak 2 Tahun</Text>
        <Text variant="body" class="mt-2">Belajar pola, urutan, dan logika sambil bermain!</Text>
      </div>

      <Icon name="rubina-anak" size={180} />

      <div class="flex items-end justify-center gap-5">
        <span class="flex flex-col items-center gap-1">
          <Icon name="rubi-kelinci" size={88} />
          <Text variant="note"><strong>Rubi</strong></Text>
        </span>
        <span class="flex flex-col items-center gap-1">
          <Icon name="bina-beruang" size={88} />
          <Text variant="note"><strong>Bina</strong></Text>
        </span>
        <span class="flex flex-col items-center gap-1">
          <Icon name="nina-rubah" size={88} />
          <Text variant="note"><strong>Nina</strong></Text>
        </span>
        <span class="flex flex-col items-center gap-1">
          <Icon name="rina-robot" size={88} />
          <Text variant="note"><strong>Rina</strong></Text>
        </span>
      </div>

      <div class="flex flex-wrap justify-center gap-2">
        <span class="rounded-full bg-rubina-pink-100 px-4 py-1 font-display text-lg font-bold text-rubina-pink-600">Pola</span>
        <span class="rounded-full bg-rubina-peach-100 px-4 py-1 font-display text-lg font-bold text-rubina-peach-600">Urutan</span>
        <span class="rounded-full bg-rubina-sky-100 px-4 py-1 font-display text-lg font-bold text-rubina-sky-600">Arah</span>
      </div>
    </div>

    <ParentNote instruksi="Biarkan anak menunjuk karakter favoritnya dan sebutkan namanya: Rubi, Bina, Nina, Rina!" />
    <Footer nomor={1} />
  </PageWrapper>
</WorksheetLayout>
