---
import WorksheetLayout from "../layouts/WorksheetLayout.astro";
import Text from "../components/base/Text.astro";
import Icon from "../components/base/Icon.astro";

const base = import.meta.env.BASE_URL;
const pdf = `${base}unduhan/petualangan-kode-rubina-full.pdf`;

interface Menu {
  nama: string;
  ikon: string;
  main: string;
  cetak: string;
}

const MENU: Menu[] = [
  { nama: "Pola", ikon: "rubi-kelinci", main: "/game/pola/01-ab", cetak: "/pola/01-ab" },
  { nama: "Urutan", ikon: "bina-beruang", main: "/game/sequencing/01-cuci-tangan", cetak: "/sequencing/01-cuci-tangan" },
  { nama: "Arah", ikon: "nina-rubah", main: "/game/arah/01-lacak-garis", cetak: "/arah/01-lacak-garis" },
  { nama: "Sebab-Akibat", ikon: "rina-robot", main: "/game/sebab-akibat/01-tombol-lampu", cetak: "/sebab-akibat/01-tombol-lampu" },
  { nama: "Kartu Gerak", ikon: "lompat", main: "/game/kartu-aktivitas", cetak: "/kartu-aktivitas" },
  { nama: "Main Bebas", ikon: "rubina-anak", main: "/game/bebas/01-buat-pola", cetak: "/bebas/01-buat-pola" },
];

const url = (r: string) => `${base}${r.replace(/^\//, "")}`;
---

<WorksheetLayout title="Beranda">
  <div class="flex min-h-screen flex-col bg-background font-sans text-ink">
    <!-- Navigasi -->
    <nav class="flex items-center justify-between px-4 py-3">
      <a href={url("/")} class="flex items-center gap-2">
        <Icon name="rubina-anak" size={44} />
        <span class="font-display text-lg font-bold">Petualangan Kode Rubina</span>
      </a>
      <div class="flex gap-4 font-sans text-base font-bold">
        <a href={url("/game/")} class="text-rubina-pink-600">Main</a>
        <a href={url("/panduan-orang-tua")} class="text-muted">Cetak</a>
      </div>
    </nav>

    <!-- Hero -->
    <header class="flex flex-col items-center gap-4 px-4 py-8 text-center">
      <div class="flex items-end justify-center gap-4">
        <Icon name="rubi-kelinci" size={72} />
        <Icon name="rubina-anak" size={120} />
        <Icon name="nina-rubah" size={72} />
      </div>
      <div>
        <Text as="h1" variant="title" class="text-rubina-pink-600">Petualangan Kode Rubina</Text>
        <Text variant="body" class="mt-2">Belajar pola, urutan, dan logika untuk anak 2 tahun — main di HP/tablet atau cetak di kertas!</Text>
      </div>
      <div class="flex flex-wrap justify-center gap-3">
        <a href={url("/game/")} class="game-tap flex min-h-[56px] items-center rounded-full bg-rubina-pink-500 px-8 font-display text-xl font-bold text-white shadow-card">
          🎮 Main Sekarang
        </a>
        <a href={pdf} download class="game-tap flex min-h-[56px] items-center rounded-full bg-surface px-8 font-display text-xl font-bold shadow-card">
          🖨 Download PDF
        </a>
      </div>
    </header>

    <!-- Pilih aktivitas -->
    <main class="mx-auto flex w-full max-w-[720px] flex-col gap-6 px-4 pb-8">
      <section>
        <Text as="h2" variant="heading" class="mb-3 text-center">Pilih Aktivitasnya!</Text>
        <div class="grid grid-cols-2 gap-4">
          {MENU.map((m) => (
            <div class="flex flex-col items-center gap-2 rounded-xl bg-surface p-4 text-center shadow-card">
              <Icon name={m.ikon} size={72} />
              <Text variant="heading">{m.nama}</Text>
              <div class="flex gap-2">
                <a href={url(m.main)} class="game-tap flex min-h-[48px] items-center rounded-full bg-rubina-mint-100 px-5 font-display text-base font-bold text-rubina-mint-600">
                  ▶ Main
                </a>
                <a href={url(m.cetak)} class="game-tap flex min-h-[48px] items-center rounded-full bg-background px-5 font-display text-base font-bold text-muted">
                  🖨 Cetak
                </a>
              </div>
            </div>
          ))}
        </div>
      </section>

      <section class="rounded-xl bg-rubina-sunny-50 border border-rubina-sunny-200 p-5 text-center">
        <Text variant="heading">Mau cetak semua sekaligus?</Text>
        <Text variant="body" class="mt-1">20 halaman A4 dalam 1 file PDF, gratis!</Text>
        <a href={pdf} download class="game-tap mt-3 inline-flex min-h-[56px] items-center rounded-full bg-rubina-sunny-500 px-8 font-display text-xl font-bold text-white shadow-card">
          ⬇ Download 20 Halaman (PDF)
        </a>
        <Text variant="note" class="mt-2">Tips: buka halaman versi cetak di browser lalu tekan Ctrl+P.</Text>
      </section>

      <section class="text-center">
        <a href={url("/panduan-orang-tua")} class="font-sans text-base font-bold text-rubina-sky-600">
          📖 Panduan untuk Orang Tua
        </a>
      </section>
    </main>

    <footer class="border-t border-line py-3 text-center">
      <p class="font-sans text-sm text-muted">Petualangan Kode Rubina • Gratis dicetak & dibagikan • Ikon: Twemoji © Twitter (CC-BY 4.0)</p>
    </footer>
  </div>
</WorksheetLayout>
