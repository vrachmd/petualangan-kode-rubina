---
// CONTOH SEMENTARA Minggu 1 — membuktikan layout + token + build jalan.
// Halaman worksheet asli (20 halaman) dibuat di Minggu 3.
import WorksheetLayout from "../layouts/WorksheetLayout.astro";
import PageWrapper from "../components/layout/PageWrapper.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import ParentNote from "../components/layout/ParentNote.astro";
import Box from "../components/base/Box.astro";
import Text from "../components/base/Text.astro";
import Arrow from "../components/base/Arrow.astro";
---

<WorksheetLayout title="Contoh Pola AB">
  <PageWrapper>
    <Header judul="Pola Merah-Kuning" karakter="Rubi si Kelinci" emoji="🐰" tint="bg-rubina-pink-100" />

    <div class="mt-6 flex flex-col gap-6">
      <Box variant="card" class="p-6">
        <Text variant="heading">Ayo warnai lingkaran kosongnya!</Text>
        <div class="mt-4 flex items-center gap-3">
          <span class="inline-block h-10 w-10 rounded-full bg-rubina-pink-500 border-2 border-white shadow-soft"></span>
          <span class="inline-block h-10 w-10 rounded-full bg-rubina-sunny-500 border-2 border-white shadow-soft"></span>
          <span class="inline-block h-10 w-10 rounded-full bg-rubina-pink-500 border-2 border-white shadow-soft"></span>
          <span class="inline-block h-10 w-10 rounded-full bg-rubina-sunny-500 border-2 border-white shadow-soft"></span>
          <span class="inline-block h-10 w-10 rounded-full border-2 border-dashed border-line bg-background"></span>
          <span class="inline-block h-10 w-10 rounded-full border-2 border-dashed border-line bg-background"></span>
        </div>
      </Box>

      <Box variant="dashed" class="flex items-center gap-4 p-6">
        <Text variant="body">Ikuti panah seperti Rubi melompat:</Text>
        <Arrow arah="kanan" size={48} class="text-rubina-pink-600" />
        <Arrow arah="kanan" size={48} class="text-rubina-pink-600" />
        <Arrow arah="bawah" size={48} class="text-rubina-sky-600" />
      </Box>
    </div>

    <ParentNote instruksi="Sebut 'merah, kuning, merah, kuning...' sambil menunjuk. Lalu tanya 'berikutnya apa?'" />

    <Footer nomor={0} />
  </PageWrapper>
</WorksheetLayout>
