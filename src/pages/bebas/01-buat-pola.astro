---
import WorksheetLayout from "../../layouts/WorksheetLayout.astro";
import PageWrapper from "../../components/layout/PageWrapper.astro";
import Header from "../../components/layout/Header.astro";
import Footer from "../../components/layout/Footer.astro";
import ParentNote from "../../components/layout/ParentNote.astro";
import Text from "../../components/base/Text.astro";
import FreePlayArea from "../../components/worksheet/FreePlayArea.astro";
---

<WorksheetLayout title="Pola Kreasiku">
  <PageWrapper>
    <Header
      judul="Pola Kreasiku"
      karakter="Rubina"
      emoji="✨"
      maskot="rubina-anak"
      tint="bg-rubina-pink-100"
    />

    <div class="mt-6 flex flex-col gap-6">
      <Text variant="heading">Hari ini giliranmu jadi guru pola!</Text>
      <FreePlayArea judul="Buat pola kesukaanmu! Warnai lingkaran ini." varian="pola" jumlah={8} />
      <FreePlayArea judul="Buat satu lagi, yang berbeda!" varian="pola" jumlah={6} />
    </div>

    <ParentNote instruksi="Biarkan anak bebas. Tidak ada salah. Tanya: 'ceritakan polamu!'" />
    <Footer nomor={19} />
  </PageWrapper>
</WorksheetLayout>
