---
import WorksheetLayout from "../../layouts/WorksheetLayout.astro";
import PageWrapper from "../../components/layout/PageWrapper.astro";
import Header from "../../components/layout/Header.astro";
import Footer from "../../components/layout/Footer.astro";
import ParentNote from "../../components/layout/ParentNote.astro";
import Text from "../../components/base/Text.astro";
import FreePlayArea from "../../components/worksheet/FreePlayArea.astro";
---

<WorksheetLayout title="Robotku">
  <PageWrapper>
    <Header judul="Robotku" karakter="Rina si Robot" emoji="🤖" maskot="rina-robot" tint="bg-rubina-lavender-100" />

    <div class="mt-6 flex flex-col gap-6">
      <Text variant="heading">Rina punya teman baru: robot buatanmu!</Text>
      <FreePlayArea judul="Gambar robotmu di sini!" varian="gambar" />
    </div>

    <ParentNote instruksi="Biarkan anak bebas. Tidak ada salah. Tanya: 'robotmu bisa apa?'" />
    <Footer nomor={20} />
  </PageWrapper>
</WorksheetLayout>
