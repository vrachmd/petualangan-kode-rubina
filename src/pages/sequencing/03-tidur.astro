---
import WorksheetLayout from "../../layouts/WorksheetLayout.astro";
import PageWrapper from "../../components/layout/PageWrapper.astro";
import Header from "../../components/layout/Header.astro";
import Footer from "../../components/layout/Footer.astro";
import ParentNote from "../../components/layout/ParentNote.astro";
import Box from "../../components/base/Box.astro";
import Text from "../../components/base/Text.astro";
import SequenceCard from "../../components/worksheet/SequenceCard.astro";
---

<WorksheetLayout title="Bobo Malam">
  <PageWrapper>
    <Header
      judul="Bobo Malam"
      karakter="Bina si Beruang"
      emoji="🐻"
      maskot="bina-beruang"
      tint="bg-rubina-peach-100"
    />

    <div class="mt-6 flex flex-col gap-6">
      <Box variant="card" class="p-6">
        <Text variant="heading">Urutkan: pertama, lalu, terakhir!</Text>
        <div class="mt-4">
          <SequenceCard
            langkah={[
              { ikon: "baju", label: "Ganti baju" },
              { ikon: "sikat-gigi", label: "Sikat gigi" },
              { ikon: "tempat-tidur", label: "Bobo!" },
            ]}
          />
        </div>
      </Box>
    </div>

    <ParentNote instruksi="Ceritakan gambar 1-2-3. Minta anak menunjuk 'pertama, lalu, terakhir'. Jadikan rutinitas sebelum bobo malam ini!" />
    <Footer nomor={9} />
  </PageWrapper>
</WorksheetLayout>
