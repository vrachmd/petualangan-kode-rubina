---
import WorksheetLayout from "../../layouts/WorksheetLayout.astro";
import PageWrapper from "../../components/layout/PageWrapper.astro";
import Header from "../../components/layout/Header.astro";
import Footer from "../../components/layout/Footer.astro";
import ParentNote from "../../components/layout/ParentNote.astro";
import Box from "../../components/base/Box.astro";
import Text from "../../components/base/Text.astro";
import SequenceCard from "../../components/worksheet/SequenceCard.astro";
---

<WorksheetLayout title="Beres Mainan">
  <PageWrapper>
    <Header judul="Beres Mainan" karakter="Bina si Beruang" emoji="🐻" maskot="bina-beruang" tint="bg-rubina-peach-100" />

    <div class="mt-6 flex flex-col gap-6">
      <Box variant="card" class="p-6">
        <Text variant="heading">Urutkan: pertama, lalu, terakhir!</Text>
        <div class="mt-4">
          <SequenceCard
            langkah={[
              { ikon: "bola", label: "Ambil mainan" },
              { ikon: "kotak", label: "Masukkan kotak" },
              { ikon: "boneka", label: "Tutup, hore!" },
            ]}
          />
        </div>
      </Box>
    </div>

    <ParentNote instruksi="Ceritakan gambar 1-2-3. Minta anak menunjuk 'pertama, lalu, terakhir'. Langsung bereskan mainan bersama!" />
    <Footer nomor={10} />
  </PageWrapper>
</WorksheetLayout>
