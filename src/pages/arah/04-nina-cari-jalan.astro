---
import WorksheetLayout from "../../layouts/WorksheetLayout.astro";
import PageWrapper from "../../components/layout/PageWrapper.astro";
import Header from "../../components/layout/Header.astro";
import Footer from "../../components/layout/Footer.astro";
import ParentNote from "../../components/layout/ParentNote.astro";
import Box from "../../components/base/Box.astro";
import Text from "../../components/base/Text.astro";
import Icon from "../../components/base/Icon.astro";
import Arrow from "../../components/base/Arrow.astro";
---

<WorksheetLayout title="Nina Pulang">
  <PageWrapper>
    <Header judul="Nina Pulang" karakter="Nina si Rubah" emoji="🦊" maskot="nina-rubah" tint="bg-rubina-sky-100" />

    <div class="mt-6 flex flex-col gap-6">
      <Box variant="card" class="p-6">
        <Text variant="heading">Bantu Nina pulang ke rumah! Ikuti panahnya.</Text>
        <div class="mt-4 flex justify-center">
          <div class="grid gap-2" style="grid-template-columns:repeat(3,72px);">
            <span class="flex items-center justify-center rounded-md bg-rubina-peach-50 border border-line" style="width:72px;height:72px"><Icon name="nina-rubah" size={56} /></span>
            <span class="flex items-center justify-center rounded-md bg-surface border border-line shadow-soft" style="width:72px;height:72px"><Arrow arah="kanan" size={46} class="text-rubina-sky-600" /></span>
            <span class="flex items-center justify-center rounded-md bg-surface border border-line shadow-soft" style="width:72px;height:72px"><Arrow arah="kanan" size={46} class="text-rubina-sky-600" /></span>
            <span class="rounded-md bg-background border border-dashed border-line" style="width:72px;height:72px"></span>
            <span class="rounded-md bg-background border border-dashed border-line" style="width:72px;height:72px"></span>
            <span class="flex items-center justify-center rounded-md bg-surface border border-line shadow-soft" style="width:72px;height:72px"><Arrow arah="bawah" size={46} class="text-rubina-sky-600" /></span>
            <span class="rounded-md bg-background border border-dashed border-line" style="width:72px;height:72px"></span>
            <span class="rounded-md bg-background border border-dashed border-line" style="width:72px;height:72px"></span>
            <span class="flex items-center justify-center rounded-md bg-rubina-mint-50 border border-line" style="width:72px;height:72px"><Icon name="rumah" size={56} /></span>
          </div>
        </div>
        <Text variant="body" class="mt-3 text-center">Kanan, kanan, turun... sampai!</Text>
      </Box>
    </div>

    <ParentNote instruksi="Minta anak menggerakkan jari dari Nina ke rumah. Sebut arahnya: 'kanan... kanan... turun!'" />
    <Footer nomor={14} />
  </PageWrapper>
</WorksheetLayout>
