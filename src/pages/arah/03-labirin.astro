---
import WorksheetLayout from "../../layouts/WorksheetLayout.astro";
import PageWrapper from "../../components/layout/PageWrapper.astro";
import Header from "../../components/layout/Header.astro";
import Footer from "../../components/layout/Footer.astro";
import ParentNote from "../../components/layout/ParentNote.astro";
import Box from "../../components/base/Box.astro";
import Text from "../../components/base/Text.astro";
import Icon from "../../components/base/Icon.astro";
---

<WorksheetLayout title="Jalan ke Wortel">
  <PageWrapper>
    <Header judul="Jalan ke Wortel" karakter="Nina si Rubah" emoji="🦊" maskot="nina-rubah" tint="bg-rubina-sky-100" />

    <div class="mt-6 flex flex-col gap-6">
      <Box variant="card" class="p-6">
        <Text variant="heading">Ikuti garisnya dengan jarimu. Mana yang sampai ke wortel?</Text>
        <div class="relative mt-4 h-[320px]">
          <svg viewBox="0 0 700 320" preserveAspectRatio="none" class="absolute inset-0 h-full w-full" aria-hidden="true">
            <path d="M70 60C180 30 260 90 380 60s180-20 250 0" stroke="#0EA5E9" stroke-width="7" stroke-dasharray="16 12" stroke-linecap="round" fill="none" vector-effect="non-scaling-stroke" />
            <path d="M70 160C180 190 280 130 400 160s180 30 230 0" stroke="#0EA5E9" stroke-width="7" stroke-dasharray="16 12" stroke-linecap="round" fill="none" vector-effect="non-scaling-stroke" />
            <path d="M70 260C200 230 300 290 420 260s180-20 210 0" stroke="#0EA5E9" stroke-width="7" stroke-dasharray="16 12" stroke-linecap="round" fill="none" vector-effect="non-scaling-stroke" />
          </svg>
          <span class="absolute left-0" style="top:18.75%;transform:translateY(-50%)"><Icon name="lingkaran-hijau" size={44} /></span>
          <span class="absolute left-0" style="top:50%;transform:translateY(-50%)"><Icon name="lingkaran-hijau" size={44} /></span>
          <span class="absolute left-0" style="top:81.25%;transform:translateY(-50%)"><Icon name="lingkaran-hijau" size={44} /></span>
          <span class="absolute right-0" style="top:18.75%;transform:translateY(-50%)"><Icon name="boneka" size={56} /></span>
          <span class="absolute right-0" style="top:50%;transform:translateY(-50%)"><Icon name="wortel" size={56} /></span>
          <span class="absolute right-0" style="top:81.25%;transform:translateY(-50%)"><Icon name="kotak" size={56} /></span>
        </div>
      </Box>
    </div>

    <ParentNote instruksi="Biarkan anak menelusuri dengan jari. Saat sampai wortel, rayakan: 'Sampai! Nina makan wortel!'" />
    <Footer nomor={13} />
  </PageWrapper>
</WorksheetLayout>
