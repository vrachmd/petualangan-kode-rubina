---
import WorksheetLayout from "../../layouts/WorksheetLayout.astro";
import PageWrapper from "../../components/layout/PageWrapper.astro";
import Header from "../../components/layout/Header.astro";
import Footer from "../../components/layout/Footer.astro";
import ParentNote from "../../components/layout/ParentNote.astro";
import Box from "../../components/base/Box.astro";
import Text from "../../components/base/Text.astro";
import Icon from "../../components/base/Icon.astro";
---

<WorksheetLayout title="Lacak Garis Nina">
  <PageWrapper>
    <Header judul="Lacak Garis Nina" karakter="Nina si Rubah" emoji="🦊" maskot="nina-rubah" tint="bg-rubina-sky-100" />

    <div class="mt-6 flex flex-col gap-5">
      <Box variant="card" class="p-6">
        <Text variant="heading">Ikuti garis putus-putus dari hijau ke bendera!</Text>
        <div class="mt-5 flex flex-col gap-5">
          <div class="flex items-center gap-3">
            <Icon name="lingkaran-hijau" size={44} />
            <svg viewBox="0 0 600 64" preserveAspectRatio="none" class="h-16 flex-1" aria-hidden="true">
              <path d="M8 32H592" stroke="#0EA5E9" stroke-width="5" stroke-dasharray="14 10" stroke-linecap="round" fill="none" vector-effect="non-scaling-stroke" />
            </svg>
            <Icon name="bendera-finish" size={44} />
          </div>
          <div class="flex items-center gap-3">
            <Icon name="lingkaran-hijau" size={44} />
            <svg viewBox="0 0 600 64" preserveAspectRatio="none" class="h-16 flex-1" aria-hidden="true">
              <path d="M8 32C80 4 140 60 220 32s140-28 220 0 100 16 152 0" stroke="#0EA5E9" stroke-width="5" stroke-dasharray="14 10" stroke-linecap="round" fill="none" vector-effect="non-scaling-stroke" />
            </svg>
            <Icon name="bendera-finish" size={44} />
          </div>
          <div class="flex items-center gap-3">
            <Icon name="lingkaran-hijau" size={44} />
            <svg viewBox="0 0 600 64" preserveAspectRatio="none" class="h-16 flex-1" aria-hidden="true">
              <path d="M8 52L104 12l96 40 96-40 96 40 96-40 96 28" stroke="#0EA5E9" stroke-width="5" stroke-dasharray="14 10" stroke-linecap="round" stroke-linejoin="round" fill="none" vector-effect="non-scaling-stroke" />
            </svg>
            <Icon name="bendera-finish" size={44} />
          </div>
        </div>
      </Box>
    </div>

    <ParentNote instruksi="Gerakkan jari anak di atas garis dulu, baru krayon. Sebut: 'lurus... lengkung... zigzag!'" />
    <Footer nomor={11} />
  </PageWrapper>
</WorksheetLayout>
