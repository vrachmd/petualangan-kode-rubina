---
import Icon from "../base/Icon.astro";
import Text from "../base/Text.astro";
import Arrow from "../base/Arrow.astro";

export interface Ujung {
  /** nama file aset (tanpa .svg) */
  ikon: string;
  /** 1–3 kata, ex: "Tekan tombol" */
  label: string;
}

interface Props {
  aksi: Ujung;
  hasil: Ujung;
}

const { aksi, hasil } = Astro.props;
---

<div class="flex items-stretch justify-center gap-3">
  <div class="flex flex-1 flex-col items-center gap-2 rounded-lg bg-rubina-lavender-50 border border-rubina-lavender-200 p-4 text-center">
    <Icon name={aksi.ikon} size={72} />
    <Text variant="body">
      <strong>{aksi.label}</strong>
    </Text>
  </div>
  <div class="flex items-center" aria-hidden="true">
    <Arrow arah="kanan" size={56} class="text-rubina-lavender-600" />
  </div>
  <div class="flex flex-1 flex-col items-center gap-2 rounded-lg bg-rubina-sunny-50 border border-rubina-sunny-200 p-4 text-center">
    <Icon name={hasil.ikon} size={72} />
    <Text variant="body">
      <strong>{hasil.label}</strong>
    </Text>
  </div>
</div>
