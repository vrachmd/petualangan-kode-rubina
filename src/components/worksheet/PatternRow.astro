---
/**
 * Baris pola untuk diwarnai/dilanjutkan anak.
 * `kelas`: utility Tailwind lengkap dari token rubina,
 * ex: "bg-rubina-pink-500" (lingkaran) atau "text-rubina-sunny-500" (bintang).
 * Bedakan BENTUK selain warna agar lolos cetak B&W.
 */
export interface PolaItem {
  bentuk: "lingkaran" | "bintang";
  kelas: string;
}

interface Props {
  items: PolaItem[];
  /** jumlah kotak kosong (dashed) untuk diisi anak */
  kosong?: number;
  /** diameter px, min 32 (default 40 untuk 2th) */
  ukuran?: number;
  /** label di bawah tiap bentuk + kotak kosong, ex: ["A","B","C","A","B","?"] */
  labels?: string[];
}

const { items, kosong = 2, ukuran = 40, labels = [] } = Astro.props;
const px = `${ukuran}px`;
const showLabels = labels.length > 0;
---

<div class="flex flex-wrap items-start gap-3" role="img" aria-label="Pola untuk dilengkapi">
  {items.map((item, i) => (
    <span class="flex flex-col items-center gap-1">
      {item.bentuk === "lingkaran" ? (
        <span
          class:list={["inline-block rounded-full border-2 border-white shadow-soft", item.kelas]}
          style={`width:${px};height:${px}`}
        />
      ) : (
        <svg
          viewBox="0 0 24 24"
          class={item.kelas}
          style={`width:${px};height:${px}`}
          aria-hidden="true"
        >
          <path
            fill="currentColor"
            d="M12 2l2.9 6.26 6.6 1.04-4.75 4.87L17.8 21 12 17.77 6.2 21l1.05-6.83L2.5 9.3l6.6-1.04z"
          />
        </svg>
      )}
      {showLabels && labels[i] && (
        <span class="font-display text-lg font-bold text-muted">{labels[i]}</span>
      )}
    </span>
  ))}
  {Array.from({ length: kosong }).map((_, k) => (
    <span class="flex flex-col items-center gap-1">
      <span
        class="inline-block rounded-full border-2 border-dashed border-line bg-background"
        style={`width:${px};height:${px}`}
      />
      {showLabels && labels[items.length + k] && (
        <span class="font-display text-lg font-bold text-muted">{labels[items.length + k]}</span>
      )}
    </span>
  ))}
</div>
