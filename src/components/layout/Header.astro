---
import Text from "../base/Text.astro";
import Icon from "../base/Icon.astro";

interface Props {
  judul: string;
  /** ex: "Rubi si Kelinci" */
  karakter: string;
  /** emoji fallback, ex: "🐰" */
  emoji: string;
  /** nama file SVG di src/assets (tanpa .svg), ex: "rubi-kelinci" */
  maskot?: string;
  /** tint header per kategori, ex: "bg-rubina-pink-100" */
  tint?: string;
}

const { judul, karakter, emoji, maskot, tint = "bg-rubina-pink-100" } = Astro.props;
---

<header class:list={["flex items-center gap-4 rounded-lg px-5 py-4", tint]}>
  {maskot ? <Icon name={maskot} size={64} /> : <span class="text-3xl" aria-hidden="true">{emoji}</span>}
  <div>
    <Text as="h1" variant="title">{judul}</Text>
    <Text variant="note">Bersama {karakter}</Text>
  </div>
</header>
