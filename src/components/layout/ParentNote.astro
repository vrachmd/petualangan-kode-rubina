---
import Text from "../base/Text.astro";

interface Props {
  /** 1–2 kalimat instruksi, ex: "Sebut 'merah, kuning...' lalu tanya 'berikutnya apa?'" */
  instruksi: string;
}

const { instruksi } = Astro.props;
---

<aside class="mt-5 flex items-start gap-3 rounded-md bg-rubina-sunny-50 border border-rubina-sunny-200 px-4 py-3">
  <span class="text-xl" aria-hidden="true">💡</span>
  <div>
    <Text variant="body">
      <strong>Bantu anak:</strong> {instruksi}
    </Text>
  </div>
</aside>
