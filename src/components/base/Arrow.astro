---
import type { ArahMata } from "../../types";

interface Props {
  arah?: ArahMata;
  /** px, min 32 */
  size?: number;
  class?: string;
}

const { arah = "kanan", size = 48, class: extra = "" } = Astro.props;

const rotasi: Record<ArahMata, number> = {
  atas: -90,
  kanan: 0,
  bawah: 90,
  kiri: 180,
};
---

<svg
  width={size}
  height={size}
  viewBox="0 0 48 48"
  fill="none"
  role="img"
  aria-label={`Panah ke ${arah}`}
  class={extra}
  style={`transform: rotate(${rotasi[arah]}deg);`}
>
  <path
    d="M8 24h28M26 14l10 10-10 10"
    stroke="currentColor"
    stroke-width="3.5"
    stroke-linecap="round"
    stroke-linejoin="round"
  />
</svg>
